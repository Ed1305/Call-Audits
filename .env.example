# Database (JSON file store)
DATABASE_PATH=./data/callaudit.json

# After the audit, delete the recording (history still keeps the report)
KEEP_AUDIO=true


# ---------------------------------------------------------------------------
# Recommended two-pass listening QA:
#   LLM_PROVIDER=gemini
#   LISTEN_MODE=audio
#   GEMINI_API_KEY=...
# Pass 1 listens (notes only). Pass 2 scores those notes against a scorecard.
# LISTEN_MODE=transcript skips audio listen and scores Whisper/text notes only.
# ---------------------------------------------------------------------------
# LLM Provider: gemini | openai | ollama | compatible
LLM_PROVIDER=gemini

# Listen mode (gemini only): audio = hear the recording; transcript = text-only
LISTEN_MODE=audio

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Prefer flash for speed; pro for toughest calls
GEMINI_MODEL=gemini-3.6-flash

# Never invent fake QA unless you explicitly want demo mode
ALLOW_DEMO_FALLBACK=false

# OpenAI — get key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (free local LLM — transcript path only)
# Install from https://ollama.com then: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Python Whisper path — only needed when NOT using Gemini audio listen
# (or when LISTEN_MODE=transcript)
PROCESSOR_ENABLED=false
PYTHON_PATH=python
PROCESSOR_SCRIPT=./processor/process_call.py

# HuggingFace token (speaker diarization via pyannote) — Whisper path only
HF_TOKEN=hf_your_token_here

# Whisper model size: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
